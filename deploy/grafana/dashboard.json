{
  "title": "Transaction Control Plane",
  "uid": "txn-control-plane",
  "description": "Throughput, latency, Kafka consumer lag, operator reconcile duration, and circuit breaker state for the transaction control plane (ingestion, processor, operator). See CLAUDE.md's minimum expected metrics and deploy/grafana/README.md.",
  "tags": ["transaction-control-plane"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "type": "row",
      "title": "Throughput",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Ingestion Transaction Throughput",
      "description": "ingestion_transactions_processed_total, by outcome",
      "id": 1,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (outcome) (rate(ingestion_transactions_processed_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Processor Transaction Throughput",
      "description": "processor_transactions_processed_total, by outcome",
      "id": 2,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (outcome) (rate(processor_transactions_processed_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Latency",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Ingestion Publish Latency (P50 / P99)",
      "description": "ingestion_publish_latency_seconds, by outcome",
      "id": 3,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum by (le, outcome) (rate(ingestion_publish_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{outcome}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum by (le, outcome) (rate(ingestion_publish_latency_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{outcome}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Processor Reconciliation Latency (P50 / P99)",
      "description": "processor_transaction_duration_seconds, by outcome and tenant",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum by (le, outcome, tenant) (rate(processor_transaction_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{outcome}}/{{tenant}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum by (le, outcome, tenant) (rate(processor_transaction_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{outcome}}/{{tenant}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Kafka Consumer Lag",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 102,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Processor Kafka Consumer Lag",
      "description": "processor_kafka_consumer_lag_messages, by tenant",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "processor_kafka_consumer_lag_messages",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Processor Active Kafka Consumers",
      "description": "processor_kafka_active_consumer_count, by tenant",
      "id": 9,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "processor_kafka_active_consumer_count",
          "legendFormat": "{{tenant}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Operator Reconcile Duration",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "TradingTenant Reconcile Duration (P50 / P99)",
      "description": "tradingtenant_reconcile_duration_seconds, by result",
      "id": 6,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.50, sum by (le, result) (rate(tradingtenant_reconcile_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{result}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "histogram_quantile(0.99, sum by (le, result) (rate(tradingtenant_reconcile_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{result}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "row",
      "title": "Circuit Breaker State",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 104,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "state-timeline",
      "title": "Ingestion → Kafka Circuit Breaker",
      "description": "ingestion_kafka_circuit_breaker_state: 0=closed, 1=half_open, 2=open, 3=unknown",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "closed", "color": "green" },
                "1": { "text": "half_open", "color": "yellow" },
                "2": { "text": "open", "color": "red" },
                "3": { "text": "unknown", "color": "purple" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "ingestion_kafka_circuit_breaker_state",
          "legendFormat": "kafka",
          "refId": "A"
        }
      ]
    },
    {
      "type": "state-timeline",
      "title": "Processor → Postgres Circuit Breakers",
      "description": "processor_postgres_circuit_breaker_state, by repository: 0=closed, 1=half_open, 2=open, 3=unknown",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 37 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "closed", "color": "green" },
                "1": { "text": "half_open", "color": "yellow" },
                "2": { "text": "open", "color": "red" },
                "3": { "text": "unknown", "color": "purple" }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "processor_postgres_circuit_breaker_state",
          "legendFormat": "{{repository}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Operator Isolation Transitions",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 45 },
      "id": 105,
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "TradingTenant Isolation Transitions",
      "description": "tradingtenant_isolation_transitions_total, by transition",
      "id": 10,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 46 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 40 } },
        "overrides": []
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
          "expr": "sum by (transition) (rate(tradingtenant_isolation_transitions_total[$__rate_interval]))",
          "legendFormat": "{{transition}}",
          "refId": "A"
        }
      ]
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus",
        "current": {},
        "refresh": 1,
        "hide": 0
      }
    ]
  }
}
